{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentOrbit",
  "version": "2.0.0-alpha.1",
  "identifier": "dev.agentorbit.AgentOrbit",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "hud",
        "title": "AgentOrbit",
        "width": 360,
        "height": 420,
        "minWidth": 240,
        "minHeight": 90,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
